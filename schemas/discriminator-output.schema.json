{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discriminator iteration output",
  "type": "object",
  "additionalProperties": false,
  "required": ["overall_status", "writer_score", "reviewer_score", "test_generator_score", "discriminator_confidence", "blocking_issues", "next_action", "evidence_summary", "policy_exceptions", "memory_proposals", "memory_not_proposed_reason", "reasoning_summary"],
  "properties": {
    "overall_status": {"type": "string", "enum": ["pass", "retry", "human_review_required", "fail"]},
    "writer_score": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewer_score": {"type": "number", "minimum": 0, "maximum": 1},
    "test_generator_score": {"type": "number", "minimum": 0, "maximum": 1},
    "discriminator_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "blocking_issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "next_action": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/action"}]},
    "evidence_summary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policy_exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "memory_proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code-writer", "code-reviewer", "code-generate-test", "discriminator"],
      "properties": {
        "code-writer": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "code-reviewer": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "code-generate-test": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "discriminator": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}
      }
    },
    "memory_not_proposed_reason": {"type": ["string", "null"], "minLength": 1},
    "reasoning_summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "issue", "required_action"],
      "properties": {
        "owner": {"type": "string", "enum": ["code-writer", "code-reviewer", "code-generate-test", "user"]},
        "issue": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_agent", "instruction"],
      "properties": {
        "target_agent": {"type": "string", "enum": ["code-writer", "code-reviewer", "code-generate-test", "user"]},
        "instruction": {"type": "string", "minLength": 1}
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principle", "reason", "evidence"],
      "properties": {
        "principle": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"overall_status": {"const": "retry"}}, "required": ["overall_status"]},
      "then": {"properties": {"next_action": {"$ref": "#/$defs/action"}}}
    },
    {
      "if": {"properties": {"overall_status": {"const": "human_review_required"}}, "required": ["overall_status"]},
      "then": {"properties": {"next_action": {"allOf": [{"$ref": "#/$defs/action"}, {"properties": {"target_agent": {"const": "user"}}}]}}}
    },
    {
      "if": {"properties": {"overall_status": {"enum": ["pass", "fail"]}}, "required": ["overall_status"]},
      "then": {"properties": {"next_action": {"type": "null"}}}
    },
    {
      "if": {"properties": {"overall_status": {"const": "pass"}}, "required": ["overall_status"]},
      "then": {"properties": {"blocking_issues": {"maxItems": 0}}}
    }
  ]
}
