{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "risk_assessment", "blocking_findings", "non_blocking_findings", "missed_tests", "review_confidence"],
  "properties": {
    "verdict": {"type": "string", "enum": ["approve", "request_changes"]},
    "risk_assessment": {"type": "string", "enum": ["low", "medium", "high"]},
    "blocking_findings": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/finding"}, {"properties": {"severity": {"enum": ["blocker", "major"]}}}]}},
    "non_blocking_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "missed_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "severity", "problem", "impact", "suggestion"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "severity": {"type": "string", "enum": ["blocker", "major", "minor"]},
        "problem": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "suggestion": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"blocking_findings": {"minItems": 1}}, "required": ["blocking_findings"]},
      "then": {"properties": {"verdict": {"const": "request_changes"}}}
    }
  ]
}
